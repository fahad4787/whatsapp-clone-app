<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aivora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bg_app</item>
    </style>
    <!-- SplashScreen API — use real launcher adaptive icon (not aivora_mark). -->
    <style name="Theme.Aivora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_app</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Aivora</item>
    </style>
</resources>
